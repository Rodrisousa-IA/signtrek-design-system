<main class="main">

<!-- TOKENS -->
<div id="page-tokens" class="page">
  <div class="ph"><div class="pt">Tokens de design</div><div class="pd">Variáveis base: cores, espaçamentos e border-radius.</div></div>
  <div class="gt">Cores principais</div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <div style="text-align:center"><div style="width:52px;height:52px;background:#0D0D12;border-radius:10px;margin-bottom:5px"></div><div style="font-size:11px;color:var(--text2)">Midnight</div><div style="font-size:10px;color:var(--text3)">#0D0D12</div></div>
    <div style="text-align:center"><div style="width:52px;height:52px;background:#7F77DD;border-radius:10px;margin-bottom:5px"></div><div style="font-size:11px;color:var(--text2)">Trek Violet</div><div style="font-size:10px;color:var(--text3)">#7F77DD</div></div>
    <div style="text-align:center"><div style="width:52px;height:52px;background:#AFA9EC;border-radius:10px;margin-bottom:5px"></div><div style="font-size:11px;color:var(--text2)">Lavender</div><div style="font-size:10px;color:var(--text3)">#AFA9EC</div></div>
    <div style="text-align:center"><div style="width:52px;height:52px;background:#F5F4FE;border-radius:10px;border:0.5px solid #E2E1F8;margin-bottom:5px"></div><div style="font-size:11px;color:var(--text2)">Frost</div><div style="font-size:10px;color:var(--text3)">#F5F4FE</div></div>
    <div style="text-align:center"><div style="width:52px;height:52px;background:#1D9E75;border-radius:10px;margin-bottom:5px"></div><div style="font-size:11px;color:var(--text2)">Signed Green</div><div style="font-size:10px;color:var(--text3)">#1D9E75</div></div>
    <div style="text-align:center"><div style="width:52px;height:52px;background:#D85A30;border-radius:10px;margin-bottom:5px"></div><div style="font-size:11px;color:var(--text2)">Alert Coral</div><div style="font-size:10px;color:var(--text3)">#D85A30</div></div>
    <div style="text-align:center"><div style="width:52px;height:52px;background:#BA7517;border-radius:10px;margin-bottom:5px"></div><div style="font-size:11px;color:var(--text2)">Amber</div><div style="font-size:10px;color:var(--text3)">#BA7517</div></div>
    <div style="text-align:center"><div style="width:52px;height:52px;background:#378ADD;border-radius:10px;margin-bottom:5px"></div><div style="font-size:11px;color:var(--text2)">Info Blue</div><div style="font-size:10px;color:var(--text3)">#378ADD</div></div>
  </div>
  <div class="gt">Escala Trek Violet</div>
  <div style="display:flex;gap:4px;flex-wrap:wrap">
    <div style="text-align:center"><div style="width:40px;height:32px;background:#F0EFFE;border-radius:5px;border:0.5px solid #E2E1F8;margin-bottom:3px"></div><div style="font-size:9px;color:var(--text3)">50</div></div>
    <div style="text-align:center"><div style="width:40px;height:32px;background:#DDDAFC;border-radius:5px;margin-bottom:3px"></div><div style="font-size:9px;color:var(--text3)">100</div></div>
    <div style="text-align:center"><div style="width:40px;height:32px;background:#C0BAF7;border-radius:5px;margin-bottom:3px"></div><div style="font-size:9px;color:var(--text3)">200</div></div>
    <div style="text-align:center"><div style="width:40px;height:32px;background:#A09AF0;border-radius:5px;margin-bottom:3px"></div><div style="font-size:9px;color:var(--text3)">300</div></div>
    <div style="text-align:center"><div style="width:40px;height:32px;background:#7F77DD;border-radius:5px;margin-bottom:3px;outline:2px solid #7F77DD;outline-offset:2px"></div><div style="font-size:9px;color:var(--v);font-weight:500">400★</div></div>
    <div style="text-align:center"><div style="width:40px;height:32px;background:#625BB8;border-radius:5px;margin-bottom:3px"></div><div style="font-size:9px;color:var(--text3)">500</div></div>
    <div style="text-align:center"><div style="width:40px;height:32px;background:#4A4499;border-radius:5px;margin-bottom:3px"></div><div style="font-size:9px;color:var(--text3)">600</div></div>
    <div style="text-align:center"><div style="width:40px;height:32px;background:#352F7A;border-radius:5px;margin-bottom:3px"></div><div style="font-size:9px;color:var(--text3)">700</div></div>
    <div style="text-align:center"><div style="width:40px;height:32px;background:#251D5C;border-radius:5px;margin-bottom:3px"></div><div style="font-size:9px;color:var(--text3)">800</div></div>
    <div style="text-align:center"><div style="width:40px;height:32px;background:#16103D;border-radius:5px;margin-bottom:3px"></div><div style="font-size:9px;color:var(--text3)">900</div></div>
    <div style="text-align:center"><div style="width:40px;height:32px;background:#0A0822;border-radius:5px;margin-bottom:3px"></div><div style="font-size:9px;color:var(--text3)">950</div></div>
  </div>
  <div class="gt">Border radius</div>
